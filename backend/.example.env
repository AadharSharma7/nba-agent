# Set locally; never paste your key into chat or commit .env.
OPENAI_API_KEY=replace-with-your-openai-api-key
GATEKEEPER_MODEL=gpt-4.1-mini
ANALYST_MODEL=gpt-4.1-mini
# Bootstrap uses your existing macOS/Postgres.app administrator.
ADMIN_DATABASE_URL=postgresql://aadhar@localhost:5432/postgres
# Bootstrap creates this dedicated non-superuser role and database.
DATABASE_URL=postgresql://nba_agent_app:local-prototype-only@localhost:5432/nba_agent
# Relative data paths are resolved from the repository root.
DATA_DIR=data/raw/kaggle/v515
MANIFEST_PATH=audit/reports/snapshot_manifest.json
# Bind to loopback only; this personal prototype has no multi-user auth.
HOST=127.0.0.1
PORT=8001
